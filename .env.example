# Required for Gemini Developer API calls. Image asset generation uses Vertex AI by default.
GEMINI_API_KEY=

# Vertex AI image generation defaults.
GOOGLE_CLOUD_PROJECT=noble-velocity-492304-b6
GOOGLE_CLOUD_LOCATION=us-central1

# Cloud Run will set this automatically when deployed to a Google Cloud project.
# GOOGLE_CLOUD_PROJECT=noble-velocity-492304-b6

# Optional: use an explicit Firestore database name.
FIRESTORE_DATABASE_ID=(default)

# Optional: bucket for curated image/audio question assets.
MEDIA_BUCKET=

# Optional for local demos without Google credentials. Do not use in production.
BOBBY_USE_MEMORY_STORE=1
